# Copy to .env. Every commented value is the default: uncomment only what you change.
# Settings are defined in backend/app/core/config.py.

# --- LLM providers (optional) ---------------------------------------------------------
# Without a key the API still answers: quoted passages for documentary questions,
# scripted plan for dossiers. With LLM_ENABLED=auto a model is used as soon as the key
# of its provider is present.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_ENABLED=auto                      # auto | on | off
# RAG_MODEL=mistral/mistral-small-latest
# AGENT_MODEL=anthropic/claude-sonnet-5-5
# JUDGE_MODEL=anthropic/claude-haiku-4-5
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
# LLM_EXTRA_PARAMS={}                   # JSON object added to every call (provider-specific)
#
# Local open-weight models served by Ollama, no key and no cost (the configuration the
# model-written answers were measured with, see docs/05-evaluation.md):
# LLM_ENABLED=on
# RAG_MODEL=ollama_chat/qwen3.5:4b
# AGENT_MODEL=ollama_chat/qwen3.5:9b
# JUDGE_MODEL=ollama_chat/qwen3.5:9b
# LLM_TIMEOUT_S=240
# LLM_EXTRA_PARAMS={"num_ctx": 16384, "temperature": 0, "reasoning_effort": "none"}
# RAG_MAX_TOKENS=600
# AGENT_MAX_TOKENS=4000
# AGENT_MAX_STEPS=6
# MAX_COST_EUR_PER_REQUEST=0.02         # RG-08: an overrun is flagged in the decision log
# USD_TO_EUR=0.90                       # indicative rate applied to provider prices

# --- API ------------------------------------------------------------------------------
# API_KEY=                              # empty = no authentication (local development only); ASCII
# CORS_ORIGINS=                         # comma-separated origins, empty = no CORS headers
# RATE_LIMIT_PER_MINUTE=60              # per API key or client address, 0 = off
# AUTO_INGEST=true                      # build the index at startup when it is missing

# --- Storage --------------------------------------------------------------------------
# DATA_DIR=                             # absolute path; default = <repository>/data
# EVALS_DIR=                            # absolute path; default = <repository>/evals
# DATABASE_URL=                         # empty = SQLite file under DATA_DIR
#                                       # PostgreSQL: postgresql://user:password@host:5432/db
# Docker Compose only:
# POSTGRES_PASSWORD=

# --- Retrieval ------------------------------------------------------------------------
# RETRIEVAL_MODE=hybrid                 # hybrid (BM25 + vectors) | bm25
# EMBEDDING_BACKEND=fastembed           # fastembed | hash (tests, no model download)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# QDRANT_URL=                           # empty = local NumPy vector file under DATA_DIR/index
# QDRANT_API_KEY=
# QDRANT_COLLECTION=dossierops_fr
# TOP_K=4
# CANDIDATE_K=20
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# MIN_CONFIDENCE=0.35                   # below: the request is passed to a handler

# --- Business rules -------------------------------------------------------------------
# RG03_MAX_AMOUNT=500                   # disputes strictly below are handled automatically
# TICKET_DEDUPE_DAYS=7

# --- Logging --------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=true

# --- Front (read by the Streamlit process, not by the API) ----------------------------
# API_URL=http://localhost:8000
